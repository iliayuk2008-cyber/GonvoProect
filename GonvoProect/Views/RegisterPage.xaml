<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GonvoProect.Views.RegisterPage"
    Shell.NavBarIsVisible="False">

    <Grid>

        <Image
            Source="background.png"
            Aspect="AspectFill"/>

        <BoxView
        Color="#08091E"
        Opacity="0.35"
        InputTransparent="True"/>


        <ScrollView>

            <VerticalStackLayout
                Padding="27,20,27,25"
                Spacing="0"
                HorizontalOptions="Center">


                <Image
                Source="logopic.png"
                WidthRequest="110"
                HeightRequest="75"
                Aspect="AspectFit"
                HorizontalOptions="Center"/>


                <Label
                Text="GONVO"
                FontFamily="InterBold"
                FontSize="29"
                TextColor="White"
                HorizontalOptions="Center"/>


                <Label
                Text="Create Account"
                FontFamily="InterSemiBold"
                FontSize="19"
                TextColor="White"
                HorizontalOptions="Center"
                Margin="0,15,0,0"/>


                <Label
                Text="Join the GONVO community"
                FontFamily="InterRegular"
                FontSize="13"
                TextColor="#A7A4CF"
                HorizontalOptions="Center"
                Margin="0,3,0,22"/>

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,0,0,5">
                    
                    <Border Style="{StaticResource BeautifulEntry}">

                        <Grid ColumnDefinitions="24,*"
                              ColumnSpacing="0">


                            <Image
                            Source="username.png"
                            Style="{StaticResource Icona}"/>
                            
                            <Entry
                            Grid.Column="1"
                            Placeholder="User name"
                            Text="{Binding Username, Mode=TwoWay}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            PlaceholderColor="#A7A4CF"/>
                            
                        </Grid>
                        
                    </Border>

                    <Label
                    Text="{Binding ErrUsername, Mode=TwoWay}"
                    FontFamily="InterRegular"
                    FontSize="14"
                    TextColor="{StaticResource ErrorColor}"
                    IsVisible="{Binding ErrUsernameVis, Mode=TwoWay}"
                    Margin="11, 0, 0, 0"/>
                </VerticalStackLayout>
                
               

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,0,0,8">
                    
                    <Border Style="{StaticResource BeautifulEntry}">

                        <Grid ColumnDefinitions="24,*"
                              ColumnSpacing="0">


                            <Image
                            Source="email.png"
                            Style="{StaticResource Icona}"/>

                            <Entry
                            Grid.Column="1"
                            Placeholder="Email"
                            Text="{Binding Email, Mode=TwoWay}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            PlaceholderColor="#A7A4CF"/>

                        </Grid>
                        
                    </Border>

                    <Label
                    Text="{Binding ErrEmail, Mode=TwoWay}"
                    FontFamily="InterRegular"
                    FontSize="14"
                    TextColor="{StaticResource ErrorColor}"
                    IsVisible="{Binding ErrEmailVis, Mode=TwoWay}"
                    Margin="11, 0, 0, 0"/>

                </VerticalStackLayout>


                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,0,0,8">

                    <Border Style="{StaticResource BeautifulEntry}">

                        <Grid ColumnDefinitions="24,*,30"
                              ColumnSpacing="0">


                            <Image
                            Source="password.png"
                            Style="{StaticResource Icona}"/>

                            <Entry
                            Grid.Column="1"
                            Placeholder="Password"
                            IsPassword="{Binding IsPasswordHidden}"    
                            Text="{Binding Password, Mode=TwoWay}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            PlaceholderColor="#A7A4CF"/>

                            <ImageButton
                            Grid.Column="2"
                            Source="{Binding PasswordEyeIcona}"
                            Command="{Binding EyeClickCommand}"
                            BackgroundColor="Transparent"
                            WidthRequest="30"
                            HeightRequest="30"
                            Padding="0"/>

                        </Grid>

                    </Border>

                    <Label
                   Text="{Binding ErrPassword, Mode=TwoWay}"
                   FontFamily="InterRegular"
                   FontSize="14"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrPasswordVis, Mode=TwoWay}"
                   Margin="11, 0, 0, 0"/>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,0,0,8">

                    <Border Style="{StaticResource BeautifulEntry}">

                        <Grid ColumnDefinitions="24,*"
                              ColumnSpacing="0">


                            <Image
                            Source="confirm.png"
                            Style="{StaticResource Icona}"/>

                            <Entry
                            Grid.Column="1"
                            Placeholder="Confirm Password"
                            Text="{Binding Confirm, Mode=TwoWay}"
                            BackgroundColor="Transparent"
                            IsPassword="true"
                            TextColor="White"
                            PlaceholderColor="#A7A4CF"/>

                        </Grid>

                    </Border>

                    <Label
                   Text="{Binding ErrConfirm, Mode=TwoWay}"
                   FontFamily="InterRegular"
                   FontSize="14"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrConfirmVis, Mode=TwoWay}"
                   Margin="11, 0, 0, 0"/>

                </VerticalStackLayout>


                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,0,0,8">

                    <Border Style="{StaticResource BeautifulEntry}">

                        <Grid ColumnDefinitions="24,*"
                              ColumnSpacing="0">


                            <Image
                            Source="birthday.png"
                            Style="{StaticResource Icona}"/>

                            <DatePicker
                                Grid.Column="1"
                                Format="dd/MM/yyyy"
                                Date="{Binding BirthDate, Mode=TwoWay}"
                                MinimumDate="1900-01-01"
                                MaximumDate="{Binding MaxBirthDate}"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontFamily="InterRegular"
                                FontSize="14"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"/>

                        </Grid>

                    </Border>

                   <Label
                   Text="{Binding ErrBirthday, Mode=TwoWay}"
                   FontFamily="InterRegular"
                   FontSize="14"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrBirthdayVis, Mode=TwoWay}"
                   Margin="11, 0, 0, 0"/>

                </VerticalStackLayout>

                <Button
                Text="Register"
                Command="{Binding RegisterCommand}"
                Style="{StaticResource BeautifulButton}"/>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="4"
                    Margin="0,15,0,5">

                    <Label
                    Text="Already have an account?"
                    FontFamily="InterRegular"
                    FontSize="16"
                    TextColor="White"
                    VerticalOptions="Center"/>


                    <Label
                    Text="Login"
                    FontFamily="InterBold"
                    FontSize="16"
                    TextColor="{StaticResource Primary}"
                    TextDecorations="Underline"
                    VerticalOptions="Center">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                            Command="{Binding LoginCommand}"/>
                        </Label.GestureRecognizers>

                    </Label>

                </HorizontalStackLayout>


            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>