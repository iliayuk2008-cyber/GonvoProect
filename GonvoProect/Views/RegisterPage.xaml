<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GonvoProect.Views.RegisterPage"
             Title="RegisterPage">
    <VerticalStackLayout>

        <Image
        Source="BackGround.png"
        Aspect="AspectFill"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"/>

        <Entry
            Text="{Binding Name, Mode=TwoWay}"
            Placeholder="Enter your Name"
            BackgroundColor="White"
            />

        <Label
            Text="{Binding ErrName}"
            TextColor="Red"
            FontSize="12"
          />

        <Entry
            Text="{Binding Email, Mode=TwoWay}"
            Placeholder="Enter your Email"
            BackgroundColor="White"
            Margin="0,0,0,0"
            />

        <Label
            Text = "{Binding ErrEmail, Mode=TwoWay}"
            TextColor="Red"
            FontSize="12" 
            />

        <Entry
            Text="{Binding Password,Mode=TwoWay}"
            Placeholder="Enter your Password"
            BackgroundColor="White"
            Margin="0,0,0,0"
            IsPassword="True"
            />

        <Label
            Text = "{Binding ErrPassword,Mode=TwoWay}"
            TextColor="Red"
            FontSize="12"            
            />

        <Label
            Text="Pick your bitrhday"
            TextColor="Black"
            FontSize="15"
            Margin="0,0,0,15"
          />

        <DatePicker
            Date="{Binding BirthDate, Mode=TwoWay}"
            MinimumDate="1900-01-01"
            MaximumDate="2026-12-31"
            Margin="0,0,0,15"
            />
        
        <Label
            Text="{Binding ErrDate}"
            TextColor="Red"
            FontSize="12"
          />

        <Button
            Text="Register..."
            Command="{Binding RegisterCommand}"
            />

        <Label
            Text="{Binding SuccessReg}"
            TextColor="Green"
            FontSize="30"
            Margin="0,20,0,15"
            HorizontalOptions="Center"
          />

    </VerticalStackLayout>
</ContentPage>