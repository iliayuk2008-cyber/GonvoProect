<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GonvoProect.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GonvoProect.Views"
    Shell.FlyoutBehavior="Locked"
    Title="GonvoProect">


    <ShellContent
        Title="SuperMainPage"
        ContentTemplate="{DataTemplate local:SuperMainPage}"
        Route="SuperMainPage" />

    <ShellContent
        Title="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />
    
    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate local:RegisterPage}"
        Route="RegisterPage" />

    <ShellContent
        Title="GamePage"
        ContentTemplate="{DataTemplate local:GamePage}"
        Route="GamePage" />

    <ShellContent
       Title="GamePageSuper3by3"
       ContentTemplate="{DataTemplate local:GamePageSuper3by3}"
       Route="GamePageSuper3by3" />


</Shell>
